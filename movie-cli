set -euo pipefail

# ponytail: bash 4+ required (macOS ships 3.2)
[[ ${BASH_VERSINFO[0]} -ge 4 ]] || { echo "movie-cli requires bash 4+ (you have $BASH_VERSION)"; echo "Install: brew install bash"; exit 1; }

# ═══════════════════════════════════════════════════════════════
# Find script directory and load libraries
# ═══════════════════════════════════════════════════════════════
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

source "$LIB_DIR/init.sh"
source "$LIB_DIR/errors.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/cache.sh"
source "$LIB_DIR/json.sh"
source "$LIB_DIR/ui.sh"
source "$LIB_DIR/player.sh"
source "$LIB_DIR/history.sh"
source "$LIB_DIR/update.sh"

# ═══════════════════════════════════════════════════════════════
# Plugin System
# ═══════════════════════════════════════════════════════════════
PLUGIN_DIR="$SCRIPT_DIR/plugins"
declare -A LOADED_PLUGINS=()

# Run a plugin function under the shell-option state the host expects.
#
# Plugins historically call `set +euo pipefail` inside their Cinemeta
# fallbacks. In all-plugin search that runs inside a throwaway subshell,
# but in single-plugin paths it executes in THIS shell and permanently
# disabled errexit/nounset/pipefail for everything afterwards — masking
# real bugs downstream. The wrapper snapshots the option state, lets the
# plugin run however it wants, then restores strict mode. Exit codes pass
# through unchanged, so behavior is identical apart from the leak fix.
run_plugin() {
    local saved_opts
    saved_opts=$(set +o)
    local rc=0
    "$@" || rc=$?
    eval "$saved_opts"
    return "$rc"
}

validate_plugin() {
    local file="$1"
    [[ -f "$file" ]] || return 1

    # Check PLUGIN_NAME is defined (non-empty, not just commented).
    # NOTE: grep the FILE directly, never `cat | grep -q`: grep -q exits on
    # the first match (PLUGIN_NAME is line 1), printf is still writing the
    # rest of a 20-30KB plugin and gets SIGPIPE → 141 → pipefail → the
    # plugin is silently rejected. Intermittent: bigger files race more.
    grep -qE '^PLUGIN_NAME="[^"]+"' "$file" || return 1

    # Check PLUGIN_API_VERSION is defined
    grep -qE '^PLUGIN_API_VERSION="[^"]+"' "$file" || return 1

    # Check plugin_search function exists
    grep -qE '^plugin_search[[:space:]]*\(\)' "$file" || return 1

    # Check plugin_get_url function exists
    grep -qE '^plugin_get_url[[:space:]]*\(\)' "$file" || return 1

    # Extract and check API version (simple grep for major version)
    local version
    version=$(grep -oE '^PLUGIN_API_VERSION="([0-9]+)' "$file" | head -1 | cut -d'"' -f2)
    [[ -n "$version" ]] || return 1
    [[ "$version" == "$HOST_API_VERSION" ]] || return 1

    return 0
}

load_plugin() {
    local file="$1"
    local name
    name=$(basename "$file" .sh)
    [[ -n "${LOADED_PLUGINS[$name]:-}" ]] && return 0
    if validate_plugin "$file"; then
        LOADED_PLUGINS["$name"]="$file"
    fi
}

discover_plugins() {
    for dir in "$PLUGIN_DIR" "$CONF_DIR/plugins"; do
        [[ -d "$dir" ]] || continue
        for plugin in "$dir"/*.sh; do
            [[ -f "$plugin" ]] || continue
            [[ "$(basename "$plugin")" == "_template.sh" ]] && continue
            load_plugin "$plugin" || true
        done
    done
}

list_plugins() {
    discover_plugins
    for name in "${!LOADED_PLUGINS[@]}"; do
        printf '%s\n' "$name"
    done | sort
}

sort_streams() {
    local json="$1"
    printf '%s' "$json" | jq -c '
        def quality_rank:
            if (.quality == "4K" or .quality == "2160p" or .quality == "2160") then 0
            elif (.quality == "2K" or .quality == "1440p" or .quality == "1440") then 1
            elif (.quality == "1080" or .quality == "1080p") then 2
            elif (.quality == "720" or .quality == "720p") then 3
            elif (.quality == "480" or .quality == "480p") then 4
            elif (.quality == "360" or .quality == "360p") then 5
            elif (.quality == "240" or .quality == "240p") then 6
            elif (.quality == "144" or .quality == "144p") then 7
            elif .quality == "auto" then 8
            else 9
            end;
        sort_by(quality_rank)
    ' 2>/dev/null || printf '%s' "$json"
}

# Verify streams — real playback check (follow redirects + referer)
# Args: $1=JSON array of stream objects
# Returns filtered JSON with only streams mpv can actually play
# Parallel verification with bounded concurrency: every stream used to run
# two curls at once, so a 60-stream episode fanned out to 120 sockets and
# saturated slow links/CDN rate limits. Workers are capped instead.
VERIFY_MAX_JOBS="${VERIFY_MAX_JOBS:-16}"

# Probe one stream URL; on success write "$1/pass_$2" (index marker).
# Runs inside its own subshell — exits don't affect the host shell.
_verify_stream_probe() {
    local tmp_verify="$1" idx="$2" url="$3"
    local -a referer_arg=()
    if [[ -n "${4:-}" && "${4:-}" != "null" ]]; then
        referer_arg=(-H "Referer: ${4}")
    elif [[ "$url" == *"vidlink"* || "$url" == *"hakunaymatata"* || "$url" == *"vodvidl"* || "$url" == *"stormvv"* ]]; then
        referer_arg=(-H "Referer: https://vidlink.pro/")
    fi
    local http_code hex
    # Curl 1: get first 16 bytes for content check
    # NOTE: plain GET (no Range) — mirrors mpv's request shape. Some
    # workers.dev proxies serve the first 1024 bytes on a Range probe
    # (206) but 403 the full-file GET mpv opens; verifying with Range
    # let those pass and fail at playback.
    # head -c 16 closes the pipe → curl gets SIGPIPE → bounded. Do NOT
    # add --max-filesize here: it aborts pre-transfer on large
    # Content-Length and returns empty hex.
    hex=$(curl -s \
        -L --connect-timeout 4 --max-time 8 \
        "${referer_arg[@]}" \
        "$url" 2>/dev/null | head -c 16 | xxd -p 2>/dev/null)
    # Curl 2: get HTTP status code
    # --max-filesize: some servers stream the whole file (fsl-buckets,
    # googleusercontent). Curl aborts with rc 63 (or 28 on max-time)
    # but STILL prints the received code — that is a live stream, and
    # the first-bytes check above already validated it as video. Only
    # a code of 000 (no response) or non-2xx fails.
    http_code=$(curl -so /dev/null -w "%{http_code}" \
        -L --connect-timeout 4 --max-time 8 --max-filesize 3145728 \
        "${referer_arg[@]}" \
        "$url" 2>/dev/null)
    # Reject non-2xx responses (000 = connection failed / no response)
    [[ ! "$http_code" =~ ^(200|206)$ ]] && exit 0
    # Reject empty hex (nothing returned)
    [[ -z "$hex" ]] && exit 0
    # Reject rate-limit / error text (Too many requests, etc.)
    [[ "$hex" =~ ^546f6f20 ]] && exit 0
    # Reject plain text error responses (not video)
    [[ "$hex" =~ ^48545450 ]] && exit 0
    # Reject JSON responses (error pages, API errors)
    [[ "$hex" =~ ^7b ]] && exit 0
    [[ "$hex" =~ ^5b ]] && exit 0
    # Reject HTML — DOCTYPE is 3c21444f4354595045 (<!DOCTYPE)
    [[ "$hex" =~ ^3c21444f4354595045 ]] && exit 0
    # Reject HTML — <html is 3c68746d6c
    [[ "$hex" =~ ^3c68746d6c ]] && exit 0
    # Reject HTML — <? (processing instruction) is 3c3f
    [[ "$hex" =~ ^3c3f ]] && exit 0
    # Accept known video signatures (hex)
    if [[ "$hex" =~ ^(234558544d3355|23455854494e46) ]]; then
        # m3u8: #EXTM3U or #EXTINF
        printf '%d\n' "$idx" > "$tmp_verify/pass_$idx"
    elif [[ "$hex" =~ (66747970) ]]; then
        # MP4 (ftyp box)
        printf '%d\n' "$idx" > "$tmp_verify/pass_$idx"
    elif [[ "$hex" =~ ^1a45dfa3 ]]; then
        # Matroska/WebM
        printf '%d\n' "$idx" > "$tmp_verify/pass_$idx"
    elif [[ "$hex" =~ ^47 ]]; then
        # MPEG-TS (0x47 sync byte)
        printf '%d\n' "$idx" > "$tmp_verify/pass_$idx"
    elif [[ "$hex" =~ ^464c56 ]]; then
        # FLV
        printf '%d\n' "$idx" > "$tmp_verify/pass_$idx"
    fi
}

verify_streams() {
    local json="$1"
    [[ -z "$json" || "$json" == "[]" ]] && { printf '[]'; return; }

    local total
    total=$(json_count "$json")

    # Extract URLs + optional per-stream referers in a single jq call
    local tmp_verify
    tmp_verify=$(mktemp -d)
    printf '%s' "$json" | jq -r 'to_entries[] | "\(.key)\t\(.value.url // "")\t\(.value.referer // "")"' \
        2>/dev/null > "$tmp_verify/urls.tsv"

    # Verify streams concurrently (bounded pool): -L follows redirects like
    # mpv. Referer bypasses CDN 403 on Vidlink URLs and per-stream referer
    # fields (e.g. hubcloud resolver chains where workers.dev CDNs hotlink-check)
    local pids=() running=0
    while IFS=$'\t' read -r idx url referer; do
        [[ -z "$url" ]] && continue
        ( _verify_stream_probe "$tmp_verify" "$idx" "$url" "$referer" ) &
        pids+=($!)
        if (( ++running >= VERIFY_MAX_JOBS )); then
            wait "${pids[0]}" 2>/dev/null || true
            pids=("${pids[@]:1}")
            (( running-- ))
        fi
    done < "$tmp_verify/urls.tsv"

    wait "${pids[@]}" 2>/dev/null || true

    # Collect valid indices and build result in a single jq call
    local valid_indices="[]"
    if compgen -G "$tmp_verify/pass_*" > /dev/null 2>&1; then
        valid_indices=$(cat "$tmp_verify"/pass_* 2>/dev/null | jq -s '.' 2>/dev/null) || valid_indices="[]"
    fi
    rm -rf "$tmp_verify"

    local result
    result=$(printf '%s' "$json" | jq --argjson idx "$valid_indices" \
        '[to_entries[] | select(.key as $k | $idx | any(. == $k)) | .value]' 2>/dev/null) || result="[]"

    local kept dropped
    kept=$(json_count "$result")
    dropped=$(( total - kept ))
    (( dropped > 0 )) && ui_info "Filtered $dropped dead stream(s), $kept working"
    printf '%s' "$result"
}

# ═══════════════════════════════════════════════════════════════
# Playback with automatic mirror fallback (CloudStream nextMirror behavior)
# Args:
#   $1 = verified streams JSON array (sorted)
#   $2 = resolve id (passed to plugin_get_url for fresh re-resolution)
#   $3 = display label
#   $4 = user-selected stream URL (played first; remaining tried in order)
#   $5 = start_time for the first attempt (resume position; optional)
#   $6 = quality for re-resolution (explicit — no caller-scope leakage)
# Flow: play selected → on failure try next stream → if all fail, re-resolve
# fresh (new tokens = new mirror set) → try once more → return 1 if still dead.
# Returns 0 if anything played (mpv exit 0/130 = user quit/interrupt = success).
# ═══════════════════════════════════════════════════════════════
play_with_fallback() {
    local streams_json="$1"
    local resolve_id="$2"
    local label="$3"
    local selected_url="$4"
    local start_time="${5:-}"
    local quality="${6:-720}"

    local attempt=0
    while (( attempt < 2 )); do
        if (( attempt == 1 )); then
            ui_info "All mirrors failed — re-resolving fresh mirrors..."
            streams_json=$(run_plugin plugin_get_url "$resolve_id" "$quality" 2>/dev/null || printf '[]')
            streams_json=$(sort_streams "$streams_json")
            streams_json=$(verify_streams "$streams_json")
        fi

        # Build play order: selected URL first (attempt 0 only), then the rest
        # in given order. On re-resolve (attempt 1) the selected URL is already
        # known dead — don't re-prepend it.
        # Each entry is "url\t<referer>" so playback can honor per-stream
        # referers (hubcloud-chain workers.dev CDNs hotlink-check).
        local play_order=()
        local i=0 seen_selected=0
        local count
        count=$(printf '%s' "$streams_json" | jq 'length' 2>/dev/null || echo 0)
        while (( i < count )); do
            local u r
            u=$(printf '%s' "$streams_json" | jq -r ".[$i].url // empty" 2>/dev/null || true)
            r=$(printf '%s' "$streams_json" | jq -r ".[$i].referer // empty" 2>/dev/null || true)
            if [[ "$attempt" == "0" && -n "$selected_url" && "$u" == "$selected_url" && "$seen_selected" == "0" ]]; then
                play_order=("$selected_url	$r" "${play_order[@]}")
                seen_selected=1
            else
                [[ -n "$u" ]] && play_order+=("$u	$r")
            fi
            i=$((i + 1))
        done
        if [[ "$attempt" == "0" && "$seen_selected" == "0" && -n "$selected_url" ]]; then
            play_order=("$selected_url	" "${play_order[@]}")
        fi

        local played=0 first=1
        for entry in "${play_order[@]}"; do
            local url="${entry%%	*}"
            local stream_referer="${entry#*	}"
            if (( first == 0 )); then
                ui_info "Previous stream failed — trying next mirror..."
            fi
            if declare -f plugin_sign_url >/dev/null 2>&1; then
                url=$(plugin_sign_url "$url")
            fi

            local rc=0
            status_msg "Playing: $label"
            local saved_no_detach="$NO_DETACH"
            NO_DETACH=1
            play_video "$url" "$start_time" "$stream_referer" || rc=$?
            NO_DETACH="$saved_no_detach"

            # 0 = user quit/finished, 130 = SIGINT — both are "played enough"
            if (( rc == 0 || rc == 130 )); then
                played=1
                break
            fi
            warn "Playback failed (rc=$rc) — trying next mirror..."
            first=0
            start_time=""  # resume position applies only to the first attempt
        done

        (( played == 1 )) && return 0
        attempt=$((attempt + 1))
    done
    return 1
}


# ═══════════════════════════════════════════════════════════════
# Dependency Check
# ═══════════════════════════════════════════════════════════════
check_deps() {
    local missing=()
    for cmd in curl jq openssl python3; do
        command -v "$cmd" &>/dev/null || missing+=("$cmd")
    done

    # ponytail: Android uses mpv-android via Play Store + intent launch,
    # not a CLI binary in $PATH. Skip player check on Termux.
    if [[ ! -d "/data/data/com.termux" ]]; then
        local player_found=0
        for cmd in mpv vlc iina; do
            command -v "$cmd" &>/dev/null && player_found=1
        done
        (( player_found == 0 )) && missing+=("mpv/vlc/iina")
    fi

    if (( ${#missing[@]} > 0 )); then
        ui_error "Missing: ${missing[*]}"
        exit 5
    fi
}

# ═══════════════════════════════════════════════════════════════
# Search & Play Pipeline
# ═══════════════════════════════════════════════════════════════

# Tag every result with the plugin that produced it (routing key for get_url).
_tag_results() {
    local results="$1" plugin="$2"
    printf '%s' "$results" | jq --arg p "$plugin" 'map(.plugin = $p)' 2>/dev/null || printf '[]'
}

# Search all loaded plugins concurrently; each runs in its own subshell so a
# plugin that dies or flips shell options cannot contaminate the host.
_search_all_plugins() {
    local query="$1" quality="$2"
    local merged_results="[]"
    local pids=() idx=0
    local tmp_dir
    tmp_dir=$(mktemp -d)
    for p_name in "${!LOADED_PLUGINS[@]}"; do
        (
            source "${LOADED_PLUGINS[$p_name]}"
            local p_res
            p_res=$(plugin_search "$query" "$quality" 2>/dev/null || printf '[]')
            if [[ -n "$p_res" && "$p_res" != "[]" ]]; then
                p_res=$(_tag_results "$p_res" "$p_name")
            fi
            printf '%s\n' "$p_res" > "$tmp_dir/out_${idx}.json"
        ) &
        pids+=($!)
        idx=$((idx + 1))
    done
    wait "${pids[@]}" 2>/dev/null || true
    if compgen -G "$tmp_dir/out_*.json" > /dev/null 2>&1; then
        merged_results=$(cat "$tmp_dir"/out_*.json 2>/dev/null | jq -s 'add' 2>/dev/null || printf '[]')
    fi
    rm -rf "$tmp_dir"
    printf '%s' "$merged_results"
}

# Resolve search results for query+plugin(+quality), honoring cache.
# Prints the merged result JSON array to stdout; exits via die_plugin when
# nothing was found (original behavior).
_search_results() {
    local query="$1" selected_plugin="$2" quality="$3"

    local results=""
    if [[ "$selected_plugin" == "all" ]]; then
        local cache_key="search|all|${query}|${quality}"
        if [[ "${NO_CACHE:-0}" != "1" ]]; then
            results=$(cache_get "$cache_key" "$CACHE_TTL_SEARCH" 2>/dev/null) || true
        fi
        if [[ -z "$results" || "$results" == "[]" ]]; then
            prof_start "search"
            status_msg "Searching all plugins..."
            results=$(_search_all_plugins "$query" "$quality")
            spinner_stop
            [[ -z "$results" || "$results" == "[]" ]] && die_plugin "No results for: $query"
            [[ "${NO_CACHE:-0}" != "1" ]] && cache_set "$cache_key" "$results"
            prof_end
        fi
    else
        [[ -n "${LOADED_PLUGINS[$selected_plugin]:-}" ]] || die_plugin "Plugin not found: $selected_plugin"
        source "${LOADED_PLUGINS[$selected_plugin]}"
        local cache_key="search|${selected_plugin}|${query}|${quality}"
        if [[ "${NO_CACHE:-0}" != "1" ]]; then
            results=$(cache_get "$cache_key" "$CACHE_TTL_SEARCH" 2>/dev/null) || true
        fi
        if [[ -z "$results" ]]; then
            status_msg "Searching..."
            # run_plugin: single-plugin search executes in THIS shell — keep
            # any `set +euo pipefail` inside the plugin from leaking out.
            results=$(run_plugin plugin_search "$query" "$quality" || printf '[]')
            spinner_stop
            [[ -z "$results" || "$results" == "[]" ]] && die_plugin "No results for: $query"
            results=$(_tag_results "$results" "$selected_plugin")
            [[ "${NO_CACHE:-0}" != "1" ]] && cache_set "$cache_key" "$results"
        fi
    fi
    printf '%s' "$results"
}

# plugin_get_url → sort → verify. The standard resolution pipeline used by
# the series flow, retry loops, and --continue. Prints verified streams.
resolve_streams_for() {
    local id="$1" quality="$2"
    local streams_json
    streams_json=$(run_plugin plugin_get_url "$id" "$quality" 2>/dev/null)
    streams_json=$(sort_streams "$streams_json")
    streams_json=$(verify_streams "$streams_json")
    printf '%s' "$streams_json"
}

# Collect stream objects from a JSON array into the _STREAMS global array.
collect_streams() {
    local json="$1"
    _STREAMS=()
    local obj
    while IFS= read -r obj; do
        [[ -n "$obj" ]] && _STREAMS+=("$obj")
    done < <(json_objects "$json")
}

# Persist final playback position for --continue (no-op on zero/invalid).
_save_playback_progress() {
    local id="$1"
    local end_pos
    end_pos=$(get_mpv_position 2>/dev/null || echo 0)
    (( end_pos > 0 )) && history_update_progress "$id" "$end_pos" "$end_pos" || true
}

search_and_play() {
    local query="$1"
    local plugin_name="$2"
    local quality="$3"

    prof_start "plugin_discovery"
    discover_plugins
    prof_end

    local selected_plugin="${plugin_name:-${CONF_PLUGIN:-all}}"
    if [[ "$selected_plugin" == "auto" ]]; then
        selected_plugin="all"
    fi

    local results
    results=$(_search_results "$query" "$selected_plugin" "$quality")

    local count
    count=$(json_count "$results")
    ui_success "Found $count results"
    (( count == 0 )) && die_plugin "No results for: $query"

    # One jq pass fills all four parallel arrays (was four jq forks).
    local R_TITLE=() R_ID=() R_TYPE=() R_PLUGIN=()
    json_fill_arrays "$results" R title id type plugin

    local -a display_titles=()
    local i=0
    while (( i < count )); do
        if [[ "$selected_plugin" == "all" ]]; then
            display_titles+=("${R_TITLE[$i]} [${R_PLUGIN[$i]}]")
        else
            display_titles+=("${R_TITLE[$i]}")
        fi
        i=$((i + 1))
    done

    # If search-only, print results and exit
    if [[ "${SEARCH_ONLY:-0}" == "1" ]]; then
        local idx=1
        for d_title in "${display_titles[@]}"; do
            printf '%d. %s\n' "$idx" "$d_title"
            idx=$((idx + 1))
        done
        prof_print
        exit 0
    fi

    local qualities_json  # shared by series/movie flows below
    # NAV LOOP: title -> [season -> [episode -> [stream]]]. "<- Back" walks
    # up one level; "no streams" sends the user back instead of exiting.
    while true; do
    select_item "Select: " "${display_titles[@]}" || exit 130
    local selected_display="$_SELECT_ITEM_RESULT"
    SELECT_N=""
    [[ "$selected_display" == "<- Back" ]] && { ui_info "Exiting."; exit 0; }

    local selected_id="" selected_type="" selected_plugin_match="" selected_title=""
    i=0
    while (( i < count )); do
        if [[ "${display_titles[$i]}" == "$selected_display" ]]; then
            selected_id="${R_ID[$i]}"
            selected_type="${R_TYPE[$i]:-movie}"
            selected_plugin_match="${R_PLUGIN[$i]}"
            selected_title="${R_TITLE[$i]}"
            break
        fi
        i=$((i + 1))
    done
    [[ -n "$selected_id" ]] || { ui_error "No ID for selection — pick again."; continue; }

    # Source the selected plugin once for all subsequent calls
    unset -f plugin_search plugin_get_url plugin_list_seasons plugin_list_episodes \
             plugin_list_languages plugin_get_url_for_language plugin_init \
             plugin_cleanup plugin_health plugin_info plugin_sign_url || true
    unset PLUGIN_NAME PLUGIN_VERSION PLUGIN_API_VERSION PLUGIN_TYPES PLUGIN_REQUIRES \
          PLUGIN_AUTHOR PLUGIN_DESCRIPTION || true
    source "${LOADED_PLUGINS[$selected_plugin_match]}"

    # Series playback flow
    if [[ "$selected_type" == "series" ]]; then
        # 1. Get seasons
        status_msg "Fetching seasons..."
        local seasons
        seasons=$(run_plugin plugin_list_seasons "$selected_id" 2>/dev/null) || seasons="[]"
        spinner_stop

        if [[ -z "$seasons" || "$seasons" == "[]" ]]; then
            ui_error "No seasons found for: $selected_title"
            continue   # back to title selection
        fi

        local S_TITLE=() S_ID=() S_NUMBER=()
        json_fill_arrays "$seasons" S title id number

        local season_count=${#S_ID[@]}
        local selected_season_number="1"

        # 2..3. Season -> Episode inner loop: episode "<- Back" must land
        # back at SEASON selection, not the outer title list.
        while true; do
            # Re-select season each iteration (episode Back lands here)
            if (( season_count > 0 )); then
                local selected_season_title
                if (( season_count == 1 )); then
                    selected_season_title="${S_TITLE[0]}"
                else
                    select_item "Select season: " "${S_TITLE[@]}" "<- Back" || exit 130
                    selected_season_title="$_SELECT_ITEM_RESULT"
                    [[ "$selected_season_title" == "<- Back" ]] && continue 2   # back to titles
                fi

                # Get the season number
                local k=0
                for t in "${S_TITLE[@]}"; do
                    if [[ "$t" == "$selected_season_title" ]]; then
                        selected_season_number="${S_NUMBER[$k]}"
                        break
                    fi
                    (( ++k ))
                done
            fi

            # 2. Get episodes
            status_msg "Fetching episodes..."
            local episodes
            episodes=$(run_plugin plugin_list_episodes "$selected_id" "$selected_season_number" 2>/dev/null) || episodes="[]"
            spinner_stop

            local E_TITLE=() E_ID=() E_SEASON=() E_EPISODE=()
            json_fill_arrays "$episodes" E title id season episode

            local ep_count=${#E_ID[@]}
            if (( ep_count == 0 )); then
                ui_error "No episodes found for season $selected_season_number — pick another."
                (( season_count > 1 )) && continue || continue 2
            fi

            # 3. Select episode (with Back → season selection)
            local selected_episode_title
            select_item "Select episode: " "${E_TITLE[@]}" "<- Back" || exit 130
            selected_episode_title="$_SELECT_ITEM_RESULT"
            # "<- Back": multi-season → season menu; single-season → titles
            # (there is no season menu to return to — otherwise Back loops
            # straight back into the same episode list forever).
            if [[ "$selected_episode_title" == "<- Back" ]]; then
                if (( season_count > 1 )); then
                    continue
                else
                    continue 2
                fi
            fi

            local ep_idx=""
            local k=0
            for t in "${E_TITLE[@]}"; do
                if [[ "$t" == "$selected_episode_title" ]]; then
                    ep_idx=$k
                    break
                fi
                (( ++k ))
            done
            [[ -n "$ep_idx" ]] || die_plugin "No episode index found"

            # 4. Playback loop
            while true; do
                local ep_title="${E_TITLE[$ep_idx]}"
                local ep_id="${E_ID[$ep_idx]}"
                local ep_num="${E_EPISODE[$ep_idx]}"
                local ep_season="${E_SEASON[$ep_idx]}"

                # Clear screen before resolving streams
                clear 2>/dev/null || true

                status_msg "Resolving streams..."
                qualities_json=$(resolve_streams_for "$ep_id" "$quality")
                spinner_stop
                if [[ -z "$qualities_json" || "$qualities_json" == "[]" ]]; then
                    ui_error "No streams for: $selected_title - $ep_title"
                    local back_choice
                    select_item "What next? " "<- Back to episodes" "Try again" || continue
                    back_choice="$_SELECT_ITEM_RESULT"
                    [[ "$back_choice" == "Try again" ]] && continue
                    break   # Back to episodes
                fi

                # Stream selection for series episodes
                collect_streams "$qualities_json"
                (( ${#_STREAMS[@]} == 0 )) && { ui_error "No streams for: $selected_title - $ep_title"; break; }

                local selected_stream
                select_stream "Select stream (or <- Back): " "${_STREAMS[@]}" "<- Back" || die_plugin "No stream selected"
                selected_stream="$_SELECT_ITEM_RESULT"
                if [[ "$selected_stream" == "<- Back" ]]; then
                    break   # back to episode selection
                fi

                local selected_url
                selected_url=$(printf '%s' "$selected_stream" | jq -r '.url' 2>/dev/null)
                [[ -z "$selected_url" ]] && die_plugin "No video URL for: $selected_title - $ep_title"

                history_add "$selected_title" "$selected_plugin_match" "$ep_id" "series" "$ep_season" "$ep_num"
                status_msg "Playing: $selected_title - $ep_title (S${ep_season}E${ep_num})"

                # Auto next-mirror: on playback failure try remaining streams, then
                # re-resolve fresh once (CloudStream behavior)
                if ! play_with_fallback "$qualities_json" "$ep_id" "$selected_title - $ep_title (S${ep_season}E${ep_num})" "$selected_url" "" "$quality"; then
                    die_plugin "No playable streams for: $selected_title - $ep_title"
                fi
                # ponytail: save final position for --continue
                _save_playback_progress "$ep_id"

                # Clear screen to wipe player output and print clean menu
                clear 2>/dev/null || true

                # Prompt choices
                local options=("next" "replay" "previous" "select" "change quality" "quit")
                local choice
                select_item "Select option: " "${options[@]}" || choice="quit"
                choice="$_SELECT_ITEM_RESULT"

                case "$choice" in
                    next)
                        if (( ep_idx + 1 < ep_count )); then
                            ep_idx=$((ep_idx + 1))
                        else
                            ui_info "No more episodes in this season."
                        fi
                        ;;
                    previous)
                        if (( ep_idx > 0 )); then
                            ep_idx=$((ep_idx - 1))
                        else
                            ui_info "Already at the first episode."
                        fi
                        ;;
                    replay)
                        # Replays current ep_idx
                        ;;
                    select)
                        local new_ep_title
                        # "<- Back" → leave the playback loop; the code after it
                        # branches to seasons (multi) or titles (single).
                        # NOTE: 'continue' here would restart the PLAYBACK loop
                        # (re-resolving streams) — wrong direction.
                        select_item "Select episode: " "${E_TITLE[@]}" "<- Back" || exit 130
                        new_ep_title="$_SELECT_ITEM_RESULT"
                        [[ "$new_ep_title" == "<- Back" ]] && break
                        local m=0
                        for t in "${E_TITLE[@]}"; do
                            if [[ "$t" == "$new_ep_title" ]]; then
                                ep_idx=$m
                                break
                            fi
                            (( ++m ))
                        done
                        ;;
                    "change quality")
                        local changed_stream
                        select_stream "Select quality: " "${_STREAMS[@]}" "<- Back" || continue
                        changed_stream="$_SELECT_ITEM_RESULT"
                        # "<- Back" → back to the playback menu (not re-resolve)
                        [[ "$changed_stream" == "<- Back" ]] && continue
                        quality=$(printf '%s' "$changed_stream" | jq -r '.quality // "auto"' 2>/dev/null)
                        ;;
                    quit)
                        break
                        ;;
                esac
            done   # end playback loop
            if (( season_count > 1 )); then
                continue   # back to SEASON selection (inner loop top)
            else
                continue 2   # single season: no menu to return to → titles
            fi
        done   # end season/episode inner loop
        exit 0
    fi

    # Movie playback flow
    status_msg "Resolving streams..."
    prof_start "stream_resolution"
    qualities_json=$(run_plugin plugin_get_url "$selected_id" "$quality" 2>/dev/null)
    if [[ -z "$qualities_json" || "$qualities_json" == "[]" ]] || [[ "$(printf '%s' "$qualities_json" | verify_streams 2>/dev/null)" == "[]" ]]; then
        qualities_json=$(verify_streams "$(sort_streams "$qualities_json")" 2>/dev/null)
    fi
    prof_end

    spinner_stop

    # No streams → offer retry / back to title selection instead of exiting
    collect_streams "$qualities_json"
    while (( ${#_STREAMS[@]} == 0 )); do
        ui_error "No streams found for: $selected_title"
        local mv_choice
        select_item "What next? " "Try again" "<- Back to search results" || exit 130
        mv_choice="$_SELECT_ITEM_RESULT"
        [[ "$mv_choice" == "<- Back to search results" ]] && { MOVIE_BACK=1; break; }
        status_msg "Resolving streams... (retry)"
        qualities_json=$(resolve_streams_for "$selected_id" "$quality")
        collect_streams "$qualities_json"
    done
    [[ "${MOVIE_BACK:-0}" == "1" ]] && { unset MOVIE_BACK; continue; }

    # Select stream (auto-plays if only one)
    local selected_stream
    select_stream "Select stream (or <- Back): " "${_STREAMS[@]}" "<- Back" || die_plugin "No stream selected"
    selected_stream="$_SELECT_ITEM_RESULT"
    [[ "$selected_stream" == "<- Back" ]] && continue

    local selected_url
    selected_url=$(printf '%s' "$selected_stream" | jq -r '.url' 2>/dev/null)
    [[ -z "$selected_url" ]] && die_plugin "No video URL for: $selected_title"

    history_add "$selected_title" "$selected_plugin_match" "$selected_id" "movie"
    prof_start "player_launch"
    # Auto next-mirror: on playback failure try remaining streams, then
    # re-resolve fresh once (CloudStream behavior)
    if ! play_with_fallback "$qualities_json" "$selected_id" "$selected_title" "$selected_url" "" "$quality"; then
        die_plugin "No playable streams for: $selected_title"
    fi
    prof_end
    # ponytail: save final position for --continue
    _save_playback_progress "$selected_id"
    done   # end of title-selection NAV LOOP (movie path: play → exit; series: exits after loop)
}

# ═══════════════════════════════════════════════════════════════
# Main — handle immediate-exit flags BEFORE any subshell
# ═══════════════════════════════════════════════════════════════
main() {
    init_dirs
    create_default_config
    load_all_config

    # Handle flags that must exit the REAL process (not a subshell)
    for arg in "$@"; do
        case "$arg" in
            -v|--version)  show_version; exit 0 ;;
            -h|--help)     show_help; exit 0 ;;
            --clear-cache) cache_clear; ui_success "Cache cleared."; exit 0 ;;
            -u|--update)   update_self; exit $? ;;
            update)        update_self; exit $? ;;
            --update-check) UPDATE_CHECK_ONLY=1; update_self; exit $? ;;
        esac
    done

    check_deps

    # Parse remaining args (no subshell!)
    local query="" plugin="" quality="$CONF_QUALITY"
    local select_n=""
    local search_only=0 log_view=0
    local delete_history=0 list_plugins_flag=0 continue_watch=0

    while (( $# > 0 )); do
        case "$1" in
            -p|--plugin)
                [[ $# -ge 2 ]] || die_user "Option $1 requires an argument"
                plugin="$2"; shift 2 ;;
            -q|--quality)
                [[ $# -ge 2 ]] || die_user "Option $1 requires an argument"
                quality="$2"; shift 2 ;;
            -s|--search-only) search_only=1; shift ;;
            -S|--select)
                [[ $# -ge 2 ]] || die_user "Option $1 requires an argument"
                [[ "$2" =~ ^[0-9]+$ ]] || die_user "Invalid $1 value: $2 (must be a number)"
                select_n="$2"; shift 2
                ;;
            --no-detach)     NO_DETACH=1; shift ;;
            -l|--log)        log_view=1; shift ;;
            -D|--delete-history) delete_history=1; shift ;;
            -c|--continue)   continue_watch=1; shift ;;
            --list-plugins)  list_plugins_flag=1; shift ;;
            --check-deps)    check_deps; ui_success "All dependencies OK."; exit 0 ;;
            --debug)         DEBUG=1; VERBOSE=1; shift ;;
            --quiet)         QUIET=1; shift ;;
            --no-color)      NO_COLOR=1; shift ;;
            --no-cache)      NO_CACHE=1; shift ;;
            --profile)       _PROFILE_ENABLED=1; shift ;;
            -*)              die_user "Unknown option: $1" ;;
            *)               query="$1"; shift ;;
        esac
    done

    # Handle non-search commands
    if (( list_plugins_flag )); then list_plugins; exit 0; fi
    if (( log_view )); then history_list 20; exit 0; fi
    if (( delete_history )); then
        confirm "Delete all watch history?" && history_clear && ui_success "History cleared."
        exit 0
    fi

    # Continue watching last entry
    if (( continue_watch )); then
        local last_entry
        last_entry=$(history_get_last) || die_user "No watch history found"
        local last_id last_type last_plugin last_season last_episode last_progress
        last_id=$(printf '%s' "$last_entry" | jq -r '.id // empty')
        last_type=$(printf '%s' "$last_entry" | jq -r '.type // "movie"')
        last_plugin=$(printf '%s' "$last_entry" | jq -r '.plugin // empty')
        last_season=$(printf '%s' "$last_entry" | jq -r '.season // "null"')
        last_episode=$(printf '%s' "$last_entry" | jq -r '.episode // "null"')
        last_progress=$(printf '%s' "$last_entry" | jq -r '.progress // 0')

        [[ -n "$last_id" ]] || die_user "No valid entry in history"

        # Re-resolve URL via plugin
        discover_plugins
        [[ -n "${LOADED_PLUGINS[$last_plugin]:-}" ]] || die_plugin "Plugin '$last_plugin' not found"
        source "${LOADED_PLUGINS[$last_plugin]}"

        local resume_id="$last_id"
        if [[ "$last_type" == "series" && "$last_season" != "null" && "$last_episode" != "null" ]]; then
            resume_id="${last_id}:${last_season}:${last_episode}"
        fi

        status_msg "Resolving streams..."
        local qualities_json
        qualities_json=$(resolve_streams_for "$resume_id" "$quality")
        spinner_stop
        [[ -z "$qualities_json" || "$qualities_json" == "[]" ]] && die_plugin "No streams for last watched entry"

        collect_streams "$qualities_json"
        (( ${#_STREAMS[@]} == 0 )) && die_plugin "No streams available"

        local selected_stream
        select_stream "Select stream: " "${_STREAMS[@]}" || die_plugin "No stream selected"
        selected_stream="$_SELECT_ITEM_RESULT"

        local selected_url
        selected_url=$(printf '%s' "$selected_stream" | jq -r '.url' 2>/dev/null)
        [[ -z "$selected_url" ]] && die_plugin "No video URL"

        local start_time=""
        (( last_progress > 0 )) && start_time="$last_progress"

        status_msg "Resuming: $(printf '%s' "$last_entry" | jq -r '.title')"
        # Auto next-mirror: on playback failure try remaining streams, then
        # re-resolve fresh once (CloudStream behavior)
        if ! play_with_fallback "$qualities_json" "$resume_id" "$(printf '%s' "$last_entry" | jq -r '.title')" "$selected_url" "$start_time" "$quality"; then
            die_plugin "No playable streams for last watched entry"
        fi
        # ponytail: save position for next --continue
        _save_playback_progress "$last_id"
        exit 0
    fi

    # If no query is passed, run interactively to prompt the user (ani-cli workflow)
    if [[ -z "$query" ]]; then
        status_msg "Checking dependencies..."
        check_deps
        printf "${C_CYAN}Search movie:${C_RESET} "
        if [[ -t 0 ]]; then
            read -r query < /dev/tty
        else
            read -r query
        fi
    fi

    # Require query and validate (Security constraints)
    [[ -n "$query" ]] || die_user "Query cannot be empty"
    (( ${#query} <= 200 )) || die_user "Query is too long (max: 200 characters)"
    query=$(printf '%s' "$query" | tr -cd '[:alnum:][:space:]._-' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -n "$query" ]] || die_user "Query contains invalid characters"

    # Re-initialize colors after CLI flags are parsed (--no-color may have been set)
    init_colors

    # Export for child processes
    export SELECT_N="$select_n" SEARCH_ONLY="$search_only" NO_DETACH="${NO_DETACH:-0}"

    search_and_play "$query" "$plugin" "$quality"
    prof_print
}

main "$@"
